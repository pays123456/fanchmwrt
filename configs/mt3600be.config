# Seed config for GL-MT3600BE (mediatek/filogic)
# 这是「差异配置」(diffconfig)，由 make defconfig 展开为完整 .config
# 行首严禁空格，每行必须为 CONFIG_XXX=y 或 # CONFIG_XXX is not set

CONFIG_HAVE_DOT_CONFIG=y
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt3600be=y

# LuCI 与中文语言包
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_oaf=y
CONFIG_LUCI_LANG_zh_Hans=y

# 无线 / 驱动
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_wpad-openssl=y

# 编译加速
CONFIG_CCACHE=y
